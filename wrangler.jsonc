{
  "name": "menote-v2",
  "main": "src/worker/src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./src/web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "preview_urls": false
}
